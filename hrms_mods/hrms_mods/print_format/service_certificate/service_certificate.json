 "font_size": 14,
 "html": "<style>\n  /* Fonts */\n  @import url('https://fonts.googleapis.com/css2?family=Cairo&family=Roboto&display=swap');\n\n  body {\n    font-family: 'Roboto', sans-serif;\n    max-width: 720px;\n    margin: 0 auto;\n    padding: 40px 0px;\n    color: #222;\n    background: #fff;\n    direction: ltr; /* base direction left to right */\n  }\n\n  .container {\n    width: 100%;\n  }\n\n  /* Header box */\n  .title-box {\n    border: 1.5px solid #222;\n    width: 300px;\n    margin: 0 auto 35px auto;\n    padding: 10px 0;\n    text-align: center;\n    font-weight: 700;\n    font-size: 13pt;\n  }\n  .title-box small {\n    display: block;\n    font-size: 11pt;\n    font-weight: 400;\n    margin-top: 4px;\n    letter-spacing: 0.06em;\n  }\n\n  /* Intro paragraphs flex */\n  .intro-section {\n    display: flex;\n    justify-content: space-between;\n    margin-bottom: 40px;\n  }\n  /* English intro */\n  .intro-eng {\n    font-family: 'Roboto', sans-serif;\n    font-size: 11pt;\n    width: 48%;\n    direction: ltr;\n    color: #333;\n    line-height: 1.5;\n  }\n  /* Arabic intro */\n  .intro-ar {\n    font-family: 'Cairo', sans-serif;\n    font-weight: 500;\n    font-size: 11pt;\n    width: 48%;\n    direction: rtl;\n    color: #333;\n    line-height: 1.5;\n    text-align: right;\n  }\n\n  /* Data rows container */\n  .data-section {\n    display: flex;\n    justify-content: space-between;\n    gap: 30px;\n  }\n\n  /* English column */\n  .col-eng {\n    font-family: 'Roboto', sans-serif;\n    font-size: 11pt;\n    color: #222;\n    width: 48%;\n    direction: ltr;\n  }\n\n  /* Arabic column */\n  .col-ar {\n    font-family: 'Cairo', sans-serif;\n    font-size: 11pt;\n    color: #222;\n    width: 48%;\n    direction: rtl;\n    text-align: right;\n  }\n\n  /* Row style in both columns */\n  .row {\n    margin: 10px 0;\n    white-space: nowrap;\n  }\n\n  .label {\n    display: inline-block;\n    font-family: 'Roboto', sans-serif;\n    font-size: 11pt;\n    min-width: 135px;\n    color: #444;\n    text-align: left;\n  }\n  .value {\n    font-weight: normal;\n  }\n\n  /* Arabic label */\n  .label-ar {\n    display: inline-block;\n    font-weight: 600;\n    min-width: 130px;\n    color: #444;\n    text-align: right;\n    margin-left: 15px;\n  }\n  .value-ar {\n    font-weight: normal;\n  }\n\n  /* Closing paragraphs */\n  .closing-section {\n    margin-top: 40px;\n    display: flex;\n    justify-content: space-between;\n  }\n  .closing-eng {\n    font-family: 'Roboto', sans-serif;\n    font-size: 11pt;\n    width: 48%;\n    direction: ltr;\n    color: #333;\n  }\n\n  .closing-ar {\n    font-family: 'Cairo', sans-serif;\n    font-weight: 500;\n    font-size: 11pt;\n    width: 48%;\n    direction: rtl;\n    text-align: right;\n    color: #333;\n  }\n\n  /* Signature section */\n  .signature {\n    margin-top: 80px;\n    margin-bottom: 150px;\n    display: flex;\n    justify-content: center;\n    gap: 20px;\n    font-size: 11pt;\n    font-weight: 700;\n    color: #222;\n  }\n  .signature .ar {\n    font-family: 'Cairo', sans-serif;\n    direction: rtl;\n  }\n  .signature .en {\n    font-family: 'Roboto', sans-serif;\n    direction: ltr;\n  }\n\n  /* Disclaimer */\n  .disclaimer {\n    font-family: 'Cairo', sans-serif;\n    direction: rtl;\n    color: #666;\n    font-size: 10pt;\n    margin-top: 60px;\n    text-align: center;\n  }\n  .disclaimer.en {\n    font-family: 'Roboto', sans-serif;\n    direction: ltr;\n    margin-top: 5px;\n    text-align: center;\n    color: #666;\n    font-size: 10pt;\n  }\n</style>\n\n<div class=\"container\">\n<div class=\"row\">\n     <div {% if print_settings.repeat_header_footer %} id=\"header-html\" class=\"hidden-pdf\" {% endif %}>\n\t\t\t\t{{ letter_head }}\n      </div>\n</div>\n  <!-- Title -->\n  <div class=\"title-box\">\n    \u0634\u0647\u0627\u062f\u0629 \u062e\u062f\u0645\u0629\n    <small>CERTIFICATE OF SERVICE</small>\n  </div>\n\n  <!-- Intro texts -->\n  <div class=\"intro-section\">\n    <p class=\"intro-eng\">\n      {{ doc.company }} hereby certifies that the person mentioned below served as an employee in the following capacity:\n    </p>\n    <p class=\"intro-ar\">\n      \u062a\u0634\u0647\u062f {{ doc.company_name_in_arabic or doc.company }} \u0628\u0623\u0646 \u0627\u0644\u0645\u0630\u0643\u0648\u0631 \u0628\u064a\u0627\u0646\u0627\u062a\u0647 \u0623\u062f\u0646\u0627\u0647 \u0642\u062f \u0639\u0645\u0644 \u0644\u062f\u064a\u0647\u0627 \u0628\u0627\u0644\u0622\u062a\u064a :\n    </p>\n  </div>\n\n  <!-- Data rows -->\n  <div class=\"data-section\">\n    <!-- English -->\n    <div class=\"col-eng\">\n      <div class=\"row\"><span class=\"label\">Name :</span><span class=\"value\">{{ doc.employee_name or \"\" }}</span></div>\n      <div class=\"row\"><span class=\"label\">Nationality :</span><span class=\"value\">{{ doc.nationality or \"\" }}</span></div>\n      <div class=\"row\"><span class=\"label\">Passport / ID No :</span><span class=\"value\">{{ doc.passport_id_no or \"\" }}</span></div>\n      <div class=\"row\"><span class=\"label\">Employee ID :</span><span class=\"value\">{{ doc.employee or \"\" }}</span></div>\n      <div class=\"row\"><span class=\"label\">Job Title :</span><span class=\"value\">{{ doc.job_title or \"\" }}</span></div>\n      <div class=\"row\"><span class=\"label\">Department :</span><span class=\"value\">{{ doc.department or \"\" }}</span></div>\n      <div class=\"row\"><span class=\"label\">Company :</span><span class=\"value\">{{ doc.company or \"\" }}</span></div>\n      <div class=\"row\"><span class=\"label\">Joining Date :</span><span class=\"value\">{{ doc.joining_date or \"\" }}</span></div>\n      <div class=\"row\"><span class=\"label\">Leaving Date :</span><span class=\"value\">{{ doc.relieving_date or \"\" }}</span></div>\n    </div>\n\n    <!-- Arabic -->\n    <div class=\"col-ar\">\n      <div class=\"row\"><span class=\"label-ar\">\u0627\u0644\u0627\u0633\u0645 :</span><span class=\"value-ar\">{{ doc.employee_name or \"\" }}</span></div>\n      <div class=\"row\"><span class=\"label-ar\">\u0627\u0644\u062c\u0646\u0633\u064a\u0629 :</span><span class=\"value-ar\">{{ doc.nationality or \"\" }}</span></div>\n      <div class=\"row\"><span class=\"label-ar\">\u0631\u0642\u0645 \u0627\u0644\u062c\u0648\u0627\u0632 / \u0627\u0644\u0647\u0648\u064a\u0629 :</span><span class=\"value-ar\">{{ doc.passport_id_no or \"\" }}</span></div>\n      <div class=\"row\"><span class=\"label-ar\">\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0648\u0638\u064a\u0641\u064a :</span><span class=\"value-ar\">{{ doc.employee or \"\" }}</span></div>\n      <div class=\"row\"><span class=\"label-ar\">\u0627\u0644\u0645\u0633\u0645\u0649 \u0627\u0644\u0648\u0638\u064a\u0641\u064a :</span><span class=\"value-ar\">{{ doc.job_title or \"\" }}</span></div>\n      <div class=\"row\"><span class=\"label-ar\">\u0627\u0644\u0625\u062f\u0627\u0631\u0629 :</span><span class=\"value-ar\">{{ doc.department or \"\" }}</span></div>\n      <div class=\"row\"><span class=\"label-ar\">\u0627\u0644\u0634\u0631\u0643\u0629 :</span><span class=\"value-ar\">{{ doc.company or \"\" }}</span></div>\n      <div class=\"row\"><span class=\"label-ar\">\u062a\u0627\u0631\u064a\u062e \u0628\u062f\u0627\u064a\u0629 \u0627\u0644\u0639\u0645\u0644 :</span><span class=\"value-ar\">{{ doc.joining_date or \"\" }}</span></div>\n      <div class=\"row\"><span class=\"label-ar\">\u062a\u0627\u0631\u064a\u062e \u0646\u0647\u0627\u064a\u0629 \u0627\u0644\u0639\u0645\u0644 :</span><span class=\"value-ar\">{{ doc.relieving_date or \"\" }}</span></div>\n    </div>\n  </div>\n\n  <!-- Closing paragraph -->\n  <div class=\"closing-section\">\n    <p class=\"closing-eng\">\n      This certificate is issued upon his request, without any liability to the company.\n    <p class=\"closing-ar\">\n      \u0648\u0642\u062f \u0623\u0635\u062f\u0631\u062a \u0644\u0647 \u0647\u0630\u0647 \u0627\u0644\u0634\u0647\u0627\u062f\u0629 \u0628\u0646\u0627\u0621 \u0639\u0644\u0649 \u0637\u0644\u0628\u0647 \u062f\u0648\u0646 \u0623\u0649 \u0645\u0633\u0626\u0648\u0644\u064a\u0629 \u0639\u0644\u0649 \u0627\u0644\u0634\u0631\u0643\u0629.\n    </p>\n  </div>\n\n  <!-- Signature -->\n  <div class=\"signature\">\n    <div class=\"en\">Human Resources Executive Director</div>\n    </br>\n    <div class=\"ar\">\u0627\u0644\u0645\u062f\u064a\u0631 \u0627\u0644\u062a\u0646\u0641\u064a\u0630\u064a \u0644\u0644\u0645\u0648\u0627\u0631\u062f \u0627\u0644\u0628\u0634\u0631\u064a\u0629</div>\n  </div>\n\n  <!-- Disclaimer -->\n  <p class=\"disclaimer\">\n    * \u0623\u064a \u062a\u0639\u062f\u064a\u0644 \u0623\u0648 \u0645\u062d\u0627\u0648\u0644\u0629 \u0644\u0644\u062a\u0644\u0627\u0639\u0628 \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0634\u0647\u0627\u062f\u0629 \u064a\u0628\u0637\u0644\u0647\u0627 \u0628\u0627\u0644\u0643\u0627\u0645\u0644\n  </p>\n  <p class=\"disclaimer en\">\n    * Any abrasion or alteration on this certificate will cancel it.\n  </p>\n\n</div>",
